# CodeSprint — environment template (SPEC §56)
#
# Copy to `.env` and fill in. NEVER commit real values; `.env` is gitignored.
#
# EXPO_PUBLIC_* variables are EMBEDDED IN THE APP BUNDLE and are PUBLIC BY DESIGN.
# Never put a secret behind an EXPO_PUBLIC_ name (SPEC §59.27).
#
# Server-only secrets do NOT belong in this file at all. They live in:
#   - Supabase secret (service-role) key .... local scripts + CI secrets
#   - REVENUECAT_SECRET_API_KEY ............ Supabase Edge Function secrets
#   - REVENUECAT_WEBHOOK_AUTH .............. Supabase Edge Function secrets + RevenueCat dashboard
#   - SENTRY_AUTH_TOKEN .................... EAS environment (secret), for source maps
#   - EXPO_TOKEN ........................... CI secrets
#   - SMTP / Apple / Google OAuth secrets ... Supabase dashboard

# ---- Required now (Phase 1) ----
# One of: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# ---- Phase 3: Supabase ----
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Phase 14: RevenueCat (PUBLIC SDK keys only) ----
# These are the *public* SDK keys, which are meant to ship in the bundle. The SECRET api key
# and the webhook secret are server-only and are listed at the top of this file; putting
# either behind an EXPO_PUBLIC_ name would publish it to every user (SPEC §56, §59.27).
#
# The two Edge Function secrets are set with:
#   npx supabase secrets set REVENUECAT_SECRET_API_KEY=... REVENUECAT_WEBHOOK_AUTH=...
# and locally by exporting them in the shell before `npx supabase start` — `config.toml`
# reads them through `[edge_runtime.secrets]`. Unset, `revenuecat-webhook` fails CLOSED and
# refuses every delivery.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# RevenueCat Test Store — simulated purchases with no App Store or Play account behind them.
# One key for both platforms. DEVELOPMENT AND PREVIEW ONLY: a production build carrying this
# refuses to start, because a released app whose purchases are fake either takes real money
# for nothing or takes none at all and looks broken.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=

# ---- Phase 15: AdMob production ad unit ids ----
# Development and preview builds ALWAYS use Google's test ids (SPEC §59.31) — `adUnitId`
# picks them from EXPO_PUBLIC_APP_ENV, so there is no way to serve a live ad from a dev
# build even by mistake. Tapping a live ad in development is what gets an AdMob account
# suspended, and it is not the kind of account you get back by apologising.
#
# The AdMob APP ids (different from the unit ids below) are build-time, not runtime:
#   ADMOB_APP_ID_ANDROID / ADMOB_APP_ID_IOS, read by app.config.ts. Both default to
#   Google's published test app ids, so a build without them still runs.
EXPO_PUBLIC_ADMOB_BANNER_ID_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ID_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_ID_IOS=
EXPO_PUBLIC_ADMOB_REWARDED_ID_ANDROID=

# ---- Phase 16: analytics + monitoring ----
# PostHog project API key. Public by design — it can only WRITE events, never read them.
# Without it the analytics service does nothing at all, and with it nothing is captured until
# the learner opts in (SPEC §41: analytics is opt-in in the EEA).
EXPO_PUBLIC_POSTHOG_KEY=
# EU region host, per SPEC §41 (EU data residency). The SDK default is US, so this matters.
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Sentry. OPTIONAL even in production: without it the app reports nothing, which is worse than
# having it but is not a reason to refuse to start (SPEC §44). Source maps need SENTRY_AUTH_TOKEN
# in the EAS environment, which is a server-only secret and is listed at the top of this file.
EXPO_PUBLIC_SENTRY_DSN=

# ---- Phase 18: static legal/support pages ----
EXPO_PUBLIC_LEGAL_BASE_URL=

# ---- Build-time, not secret (used by app.config.ts / EAS) ----
# EAS_PROJECT_ID=
